# 生产环境 Docker 部署 — 复制为 .env 后修改
JWT_SECRET=请替换为至少32位随机字符串

# 首次部署空数据卷时设为 true，从 prisma/init.db 初始化；已有业务数据必须为 false
INIT_DB=true

# 版本升级后设为 true 可自动执行业绩/客户状态回填（可选，也可手动 docker compose run）
RUN_SYNC=false

# Cookie Secure：纯 HTTP 访问设为 false；HTTPS 可省略或 true（见 docs/DEPLOY.md）
# COOKIE_SECURE=false

# 强制开放 /welcome 自助注册。已有业务账号的生产环境禁止设为 true（默认仅空库可注册）
# ENABLE_SELF_REGISTER=false

# 对外端口（宿主机 Nginx 反代时可仅映射 127.0.0.1:3001）
APP_PORT=3001

# 数据持久化根目录（数据库与上传文件分别挂载到其 db/ 与 uploads/ 子目录）
# 默认 /data/service/maofu/maofu_crm/maofu_crm_data，可按服务器实际磁盘调整
# DATA_DIR=/data/service/maofu/maofu_crm/maofu_crm_data

# 启用 compose 中的 Nginx 服务（docker compose --profile nginx up -d）
# NGINX_HTTP_PORT=80
